# Variables base para docker-compose.yml (copiar a .env si quieres cambiarlas)
PPLX_PORT=8000
PPLX_TIMEOUT_S=180

# Google AI Studio (Gemini API). Si esta definida, el gateway registra
# gemini-2.5-flash (alias gemini-flash, gemini-1.5-flash) y gemini-2.5-pro
# (alias gemini-pro) ademas del backend web.
GEMINI_API_KEY=
